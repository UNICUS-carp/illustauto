# Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# ========================================
# WebAuthn Configuration
# ========================================
RP_NAME=IllustAuto
RP_ID=unicus.top
ORIGIN=https://unicus.top

# ========================================
# Timeout Configuration (in milliseconds)
# ========================================

# Registration timeout - 登録操作のタイムアウト
# 推奨: 120000-180000 (2-3分)
# ユーザーが生体認証デバイスの使い方を理解し、操作を完了するのに十分な時間を提供
REGISTRATION_TIMEOUT=120000

# Authentication timeout - 認証操作のタイムアウト
# 推奨: 90000-120000 (1.5-2分)
# 登録よりやや短めに設定
AUTHENTICATION_TIMEOUT=90000

# Challenge expiry - チャレンジの有効期限
# 推奨: 300000-600000 (5-10分)
# ページの再読み込みや再試行を考慮
CHALLENGE_EXPIRY=300000

# Session timeout - セッションタイムアウト
# 推奨: 3600000 (1時間)
SESSION_TIMEOUT=3600000

# ========================================
# Retry Configuration
# ========================================

# Maximum retry attempts - 最大リトライ回数
MAX_RETRIES=3

# Retry delay - リトライ間の遅延（ミリ秒）
RETRY_DELAY=1000

# Exponential backoff - 指数バックオフを使用
EXPONENTIAL_BACKOFF=true

# Maximum retry delay - 最大リトライ遅延
MAX_RETRY_DELAY=10000

# ========================================
# Logging Configuration
# ========================================

# Log directory - ログディレクトリ
LOG_DIR=./logs

# Enable console logging - コンソールログを有効化
ENABLE_CONSOLE_LOG=true

# Enable file logging - ファイルログを有効化
ENABLE_FILE_LOG=true

# Max log file size - ログファイルの最大サイズ（バイト）
MAX_LOG_SIZE=10485760

# Max log files - 保持する最大ログファイル数
MAX_LOG_FILES=10

# Log level - ログレベル (debug, info, warn, error)
LOG_LEVEL=info

# ========================================
# Security Configuration
# ========================================

# Allowed origins - 許可するオリジン（カンマ区切り）
ALLOWED_ORIGINS=https://unicus.top

# Maximum login attempts - ロックアウト前の最大ログイン試行回数
MAX_LOGIN_ATTEMPTS=5

# Lockout duration - ロックアウト期間（ミリ秒）
LOCKOUT_DURATION=900000

# Require user verification - ユーザー検証を要求
REQUIRE_USER_VERIFICATION=true

# ========================================
# User Experience Configuration
# ========================================

# Show detailed errors - 詳細なエラーメッセージを表示（本番環境では無効化を推奨）
SHOW_DETAILED_ERRORS=false

# Show retry suggestions - リトライの提案を表示
SHOW_RETRY_SUGGESTIONS=true

# Show timeout countdown - タイムアウトカウントダウンを表示
SHOW_TIMEOUT_COUNTDOWN=true

# Allow timeout extension - タイムアウト延長を許可
ALLOW_TIMEOUT_EXTENSION=false

# ========================================
# Monitoring Configuration
# ========================================

# Enable statistics - 統計情報の収集を有効化
ENABLE_STATS=true

# Statistics period - 統計収集期間（時間）
STATS_PERIOD=24

# Error rate threshold - エラー率の閾値（1時間あたりのエラー数）
ERROR_RATE_THRESHOLD=10

# Enable webhook notifications - Webhook通知を有効化
ENABLE_WEBHOOK_NOTIFICATIONS=false

# Webhook URL - 通知先のWebhook URL
WEBHOOK_URL=

# ========================================
# Database Configuration
# ========================================
DATABASE_PATH=./data/illustauto.db
BACKUP_DIR=./backups

# ========================================
# Server Configuration
# ========================================
PORT=8080
MAX_CONTENT_LENGTH=5000
NODE_ENV=production
